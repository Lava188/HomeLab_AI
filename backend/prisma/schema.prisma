generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  RESCHEDULED
  ASSIGNED
  SAMPLE_COLLECTED
  IN_LAB_PROCESSING
  RESULT_READY
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum StaffRole {
  ADMIN
  STAFF
  SAMPLE_COLLECTOR
  LAB_TECHNICIAN
}

enum CreatedSource {
  CHAT
  ADMIN
  STAFF
}

enum CollectorAssignmentStatus {
  PENDING_COLLECTOR_CONFIRMATION
  ACCEPTED
  REJECTED_PENDING_ADMIN_REVIEW
  REJECTION_APPROVED
  REJECTION_REJECTED
  CANCELLED
  EXPIRED
  SUPERSEDED
}

enum AssignmentSource {
  AUTO
  ADMIN
}

enum AssignmentReviewStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Patient {
  id             String         @id @default(cuid())
  fullName       String
  phone          String         @unique
  passwordHash   String?
  email          String?
  dateOfBirth    DateTime?
  gender         String?
  defaultAddress String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  bookings       Booking[]
  bookingDrafts  BookingDraft[]
}

model TestCatalogItem {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String? @db.Text
  category    String?
  sampleType  String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
}

model StaffProfile {
  id                   String                     @id @default(cuid())
  fullName             String
  phone                String?
  passwordHash         String?
  role                 StaffRole
  serviceArea          String?                    @db.Text
  active               Boolean                    @default(true)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  assignedBookings     Booking[]
  workingAreas         CollectorWorkingArea[]
  workingSchedules     CollectorWorkingSchedule[]
  collectorAssignments CollectorAssignment[]
  notifications        Notification[]
}

model AvailabilitySlot {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  startTime   DateTime @db.Time(0)
  endTime     DateTime @db.Time(0)
  capacity    Int
  bookedCount Int      @default(0)
  area        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date, area])
}

model Booking {
  id                   String                 @id @default(cuid())
  bookingCode          String                 @unique
  patientId            String?
  testCatalogItemId    String?
  testTypeText         String?
  sampleDate           DateTime               @db.Date
  sampleTimeStart      DateTime?              @db.Time(0)
  sampleTimeEnd        DateTime?              @db.Time(0)
  address              String                 @db.Text
  phone                String
  patientName          String?
  status               BookingStatus          @default(DRAFT)
  note                 String?                @db.Text
  internalNote         String?                @db.Text
  assignedStaffId      String?
  createdFromSessionId String?
  createdSource        CreatedSource          @default(CHAT)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  cancelledAt          DateTime?
  completedAt          DateTime?
  patient              Patient?               @relation(fields: [patientId], references: [id])
  testCatalogItem      TestCatalogItem?       @relation(fields: [testCatalogItemId], references: [id])
  assignedStaff        StaffProfile?          @relation(fields: [assignedStaffId], references: [id])
  statusHistory        BookingStatusHistory[]
  collectorAssignments CollectorAssignment[]
  notifications        Notification[]

  @@index([patientId])
  @@index([testCatalogItemId])
  @@index([assignedStaffId])
  @@index([status])
  @@index([sampleDate])
  @@index([createdFromSessionId])
}

model BookingDraft {
  id            String        @id @default(cuid())
  sessionId     String
  patientId     String?
  slotsJson     Json
  missingFields Json
  status        BookingStatus @default(DRAFT)
  expiresAt     DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  patient       Patient?      @relation(fields: [patientId], references: [id])

  @@index([sessionId])
  @@index([patientId])
  @@index([status])
  @@index([expiresAt])
}

model BookingStatusHistory {
  id            String         @id @default(cuid())
  bookingId     String
  fromStatus    BookingStatus?
  toStatus      BookingStatus
  reason        String?
  changedByType String
  changedById   String?
  metadata      Json?
  createdAt     DateTime       @default(now())
  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([toStatus])
  @@index([createdAt])
}

model CollectorWorkingArea {
  id             String       @id @default(cuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  province       String
  district       String?
  ward           String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([staffProfileId])
  @@index([province, district, ward])
}

model CollectorWorkingSchedule {
  id             String       @id @default(cuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  workDate       DateTime     @db.Date
  startTime      String
  endTime        String
  active         Boolean      @default(true)
  capacity       Int          @default(8)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([staffProfileId])
  @@index([workDate])
  @@index([staffProfileId, workDate])
}

model CollectorAssignment {
  id                 String                       @id @default(cuid())
  bookingId          String
  booking            Booking                      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  collectorId        String
  collector          StaffProfile                 @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  status             CollectorAssignmentStatus    @default(PENDING_COLLECTOR_CONFIRMATION)
  assignmentSource   AssignmentSource             @default(AUTO)
  reviewStatus       AssignmentReviewStatus       @default(NONE)
  assignedAt         DateTime                     @default(now())
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  rejectReason       String?                      @db.Text
  adminReviewedById  String?
  adminReviewedAt    DateTime?
  expiresAt          DateTime?
  metadata           Json?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  assignmentHistory  CollectorAssignmentHistory[]
  notifications      Notification[]

  @@index([bookingId])
  @@index([collectorId])
  @@index([status])
  @@index([assignmentSource])
  @@index([createdAt])
}

model CollectorAssignmentHistory {
  id           String                     @id @default(cuid())
  assignmentId String
  assignment   CollectorAssignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fromStatus   CollectorAssignmentStatus?
  toStatus     CollectorAssignmentStatus
  actorType    String
  actorId      String?
  reason       String?                    @db.Text
  metadata     Json?
  createdAt    DateTime                   @default(now())

  @@index([assignmentId])
  @@index([toStatus])
  @@index([createdAt])
}

enum NotificationRoleTarget {
  ADMIN
  COLLECTOR
}

enum NotificationType {
  BOOKING_CREATED
  ASSIGNMENT_AUTO_CREATED
  ASSIGNMENT_MANUAL_CREATED
  ASSIGNMENT_REJECTED
  COLLECTOR_TASK_ASSIGNED
}

model Notification {
  id             String                @id @default(cuid())
  roleTarget     NotificationRoleTarget
  userId         String?
  staffProfileId String?
  staffProfile   StaffProfile?         @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)
  type           NotificationType
  title          String
  message        String                @db.Text
  bookingId      String?
  booking        Booking?              @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  assignmentId   String?
  assignment     CollectorAssignment?  @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  metadata       String?               @db.Text
  readAt         DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([roleTarget])
  @@index([userId])
  @@index([staffProfileId])
  @@index([type])
  @@index([bookingId])
  @@index([assignmentId])
  @@index([readAt])
  @@index([createdAt])
}
